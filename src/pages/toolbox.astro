---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Tile from '../components/Tile.astro';
import CtaStrip from '../components/CtaStrip.astro';

const tools = [
  {
    title: 'Floor Plan Builder',
    status: 'Live',
    body: 'Sketch a floor plan, get a 3D preview, framing plan, full PDF set, and a Revit-ready bundle. Permit-ready outputs without the Revit learning curve.',
    bullets: [
      'Drag-and-draw walls, doors, windows',
      '3D preview as you sketch',
      'PDF plan set + Revit bundle export',
    ],
  },
  {
    title: 'Project Builder',
    status: 'Coming soon',
    body: 'Set up structured projects that every other tool attaches to. One source of truth for levels, scopes, deliverables, and exports.',
  },
  {
    title: 'PDF Floor Plan Importer',
    status: 'Coming soon',
    body: 'Drop in an existing PDF set and get a parsed model back — walls, doors, dimensions, room labels, ready to refine in Floor Plan Builder.',
  },
  {
    title: 'CONTAM Automation',
    status: 'On the roadmap',
    body: 'Smoke-control modeling for high-rise residential. The boring half of code compliance, automated.',
  },
  {
    title: 'Submittal-to-Family',
    status: 'On the roadmap',
    body: 'Manufacturer PDF in, Revit family out. Stop hand-modeling the same VAV box for the fifth time this month.',
  },
];

const steps = [
  {
    n: '01',
    title: 'Sign in',
    body: 'Open toolbox.ibe.engineering and sign in. Account creation takes a minute.',
  },
  {
    n: '02',
    title: 'Start a project',
    body: 'Pick a tool, set up your project shell, and start working. Tools share the same project data.',
  },
  {
    n: '03',
    title: 'Export and ship',
    body: 'Pull a PDF set, a Revit bundle, or a 3D preview link. Use it in your sales call, your permit set, or your BIM model.',
  },
];
---

<Base
  title="IBE Toolbox — pro-grade building tools, on demand"
  description="The IBE Toolbox is a paid hub of building-design tools for AEC firms and small-scale builders. Floor Plan Builder is live; more tools are landing."
>
  <Hero
    eyebrow="The IBE Toolbox"
    headlineLead="Pro-grade building tools, "
    underlinedWord="on demand."
    headlineTail=""
    sub="For AEC firms running coordinated builds and for small-scale builders, remodelers, and designers who need permit-ready outputs without a full design team."
    primaryHref="https://toolbox.ibe.engineering"
    primaryLabel="Open the Toolbox"
  />

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">What's inside</span>
      <h2 class="section__heading">One hub. More tools landing as we prove them in our own workflow.</h2>
      <div class="tools-grid">
        {tools.map((t) => (
          <Tile
            title={t.title}
            status={t.status}
            body={t.body}
            bullets={t.bullets}
            variant="tool"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">How it works</span>
      <h2 class="section__heading">Three steps from sketch to shipped.</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li class="steps__item">
            <span class="steps__num">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container pricing">
      <span class="eyebrow">Pricing</span>
      <h2 class="section__heading">Pay per export, per project, or by subscription.</h2>
      <p class="pricing__lead">
        We're finalizing pricing as more tools come online. Open the Toolbox to see current
        options — Floor Plan Builder is live now, and early Toolbox users help shape what gets
        built next.
      </p>
      <div class="pricing__ctas">
        <a href="https://toolbox.ibe.engineering" class="btn btn--primary" rel="noopener">
          Open the Toolbox
        </a>
        <a
          href="mailto:info@ibe.engineering?subject=Toolbox%20question"
          class="btn btn--secondary"
        >
          Ask us anything
        </a>
      </div>
    </div>
  </section>

  <CtaStrip
    taglineLead="Pro-grade. "
    taglineWord="On demand."
    taglineTail=""
    primaryHref="https://toolbox.ibe.engineering"
    primaryLabel="Open the Toolbox"
  />
</Base>

<style>
  .section__heading {
    margin-top: var(--s-2);
    margin-bottom: var(--s-8);
    max-width: 28ch;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-6);
  }

  /* The 4th and 5th tiles span half each on the second row */
  .tools-grid > :nth-child(4),
  .tools-grid > :nth-child(5) {
    grid-column: span 1;
  }

  @media (max-width: 980px) {
    .tools-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .tools-grid {
      grid-template-columns: 1fr;
    }
  }

  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-8);
    counter-reset: step;
  }

  .steps__item {
    display: grid;
    gap: var(--s-3);
    border-top: 3px solid var(--color-accent);
    padding-top: var(--s-4);
  }

  .steps__num {
    font-family: var(--font-sans);
    font-weight: var(--fw-bold);
    font-size: var(--fs-small);
    color: var(--color-accent);
    letter-spacing: 0.1em;
  }

  .steps__item h3 {
    font-size: var(--fs-h3);
  }

  .steps__item p {
    color: var(--color-ink-muted);
    line-height: var(--lh-snug);
  }

  @media (max-width: 760px) {
    .steps {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
  }

  .pricing__lead {
    font-size: var(--fs-h3);
    color: var(--color-ink-muted);
    line-height: var(--lh-snug);
    max-width: 56ch;
    margin-bottom: var(--s-8);
  }

  .pricing__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .pricing__ctas .btn {
    padding: var(--s-4) var(--s-6);
    font-size: var(--fs-body);
  }
</style>
