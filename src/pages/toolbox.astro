---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Tile from '../components/Tile.astro';
import CtaStrip from '../components/CtaStrip.astro';
import { loadCatalog, type CatalogTool } from '../lib/catalog';

const TOOLBOX_APP = 'https://toolbox.ibe.engineering';

// Tool list comes from the live toolbox catalog at build time (with a committed
// fallback), so this page can't invent tools that don't exist.
const catalog = await loadCatalog();

// Marketing override (deliberate, per Tyler's 2026-06-17 walkthrough): on the
// public site we advertise only Integrat3D Studio as "Live" today. The other
// public-tier tools are shown "Coming soon" until they're self-serve-ready —
// even when the catalog marks them live — so a visitor never clicks into a tool
// that isn't ready for them. To advertise another tool as live, add its id here.
const LIVE_ON_MARKETING = new Set(['floor-plan']);

// Marketing enrichment layered over catalog truth — name always comes from the
// catalog; we add longer body copy and bullets per tool id.
const enrichment: Record<string, { body?: string; bullets?: string[] }> = {
  'floor-plan': {
    body: 'Sketch a floor plan, get a 3D preview, framing plan, full PDF set, and a Revit-ready bundle. Permit-ready outputs without the Revit learning curve.',
    bullets: [
      'Drag-and-draw walls, doors, windows',
      '3D preview as you sketch',
      'PDF plan set + Revit bundle export',
    ],
  },
  'pdf-importer': {
    body: 'Drop in an existing PDF plan set and get a parsed model back — walls, rooms, and dimensions ready to refine in Integrat3D Studio.',
  },
  'submittal-to-family': {
    body: 'Upload a manufacturer submittal PDF and get a Revit family back — equipment geometry and parameters extracted for you.',
  },
  'smart-documents': {
    body: 'Open a plan set and keep working in it — versioned, model-aware, and fast. Mark it up, compare revisions, and stay in sync with the model instead of flattening everything back to static PDFs.',
  },
};

const tileFor = (t: CatalogTool) => {
  const isLive = LIVE_ON_MARKETING.has(t.id);
  return {
    title: t.name,
    status: isLive ? 'Live' : 'Coming soon',
    body: enrichment[t.id]?.body ?? t.blurb,
    bullets: enrichment[t.id]?.bullets,
    ctaHref: isLive && t.web ? `${TOOLBOX_APP}${t.web}` : undefined,
    ctaLabel: isLive && t.web ? 'Open in Toolbox' : undefined,
  };
};

// Self-serve tier: what anyone can reach at toolbox.ibe.engineering.
const selfServe = catalog.tools.filter((t) => t.tier === 'public').map(tileFor);

const faq = [
  {
    q: 'Does the Toolbox replace an engineer?',
    a: 'No. The Toolbox speeds up modeling, coordination, and early-stage deliverables. Engineering judgment, code review, and stamped documents still require qualified professionals.',
  },
  {
    q: 'What outputs does Integrat3D Studio generate?',
    a: 'Floor plans, framing layouts, PDF exports, 3D previews, and Revit-ready bundles — the deliverables a builder or coordinator actually hands off.',
  },
  {
    q: 'Who is the Toolbox for?',
    a: 'AEC firms, remodelers, builders, estimators, and designers who need faster building-design workflows without living inside Revit full time.',
  },
  {
    q: 'Can I export to Revit?',
    a: 'Yes. The Toolbox is designed around Revit-native workflows and exports.',
  },
];
---

<Base
  title="IBE Toolbox | Building design and Revit export tools"
  description="Sketch floor plans, import PDF plan sets, generate framing layouts, and export Revit-ready building packages with the IBE Toolbox. Pay per project — only when you export."
>
  <Hero
    eyebrow="The IBE Toolbox"
    headlineLead="Pro-grade building tools, "
    underlinedWord="on demand."
    headlineTail=""
    sub="Browser-based building-design workflows for AEC firms, remodelers, and builders. Sketch floor plans, preview designs in 3D, and export Revit-ready deliverables."
    primaryHref="https://toolbox.ibe.engineering/toolbox"
    primaryLabel="Open the Toolbox"
    secondaryHref="mailto:info@ibe.engineering?subject=Toolbox%20question"
    secondaryLabel="Talk to our engineers"
  />

  <section class="section">
    <div class="container">
      {/* TODO(Tyler): replace with a real Integrat3D Studio screenshot in public/images. */}
      <figure class="screenshot-ph" aria-label="Integrat3D Studio interface preview">
        <span class="screenshot-ph__label">Integrat3D Studio — screenshot coming</span>
      </figure>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">In the Toolbox</span>
      <h2 class="section__heading">Built from real coordination workflows.</h2>
      <div class="tools-grid">
        {selfServe.map((t) => (
          <Tile
            title={t.title}
            status={t.status}
            body={t.body}
            bullets={t.bullets}
            ctaHref={t.ctaHref}
            ctaLabel={t.ctaLabel}
            variant="tool"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container missing">
      <div>
        <span class="eyebrow">Why we built it</span>
        <h2 class="section__heading">The missing 20%.</h2>
      </div>
      <div class="missing__copy">
        <p>
          Plenty of tools get you a nice-looking floor plan. Almost none get you the part that
          actually matters on a jobsite: coordinated, permit-ready, Revit-native output a builder
          can hand to a crew.
        </p>
        <p>
          The Toolbox is built around that last 20% — the framing, coordination, and export work
          that usually means hiring a drafter or learning Revit yourself. It comes straight out of
          the workflows our own engineers run on real coordinated projects.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container pricing">
      <div>
        <span class="eyebrow">Pricing</span>
        <h2 class="section__heading">Pay per project — only when you export.</h2>
      </div>
      <div class="pricing__copy">
        <p>
          No subscription and no seat fees. You set up a project and work in the Toolbox up front,
          and you only pay when you export a finished deliverable — a plan set, a model, or a
          Revit bundle.
        </p>
        <p>
          Pricing scales with the project, not a monthly bill. Volume and team pricing for firms
          is available — <a href="mailto:info@ibe.engineering?subject=Toolbox%20pricing">talk to us</a>.
        </p>
        <a href="https://toolbox.ibe.engineering/toolbox" class="btn btn--primary" rel="noopener">Open the Toolbox</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container faq">
      <span class="eyebrow">Toolbox FAQ</span>
      <h2 class="section__heading">Questions about the software.</h2>

      <div class="faq-grid">
        {faq.map((item) => (
          <article class="faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaStrip
    taglineLead="Pro-grade. "
    taglineWord="On demand."
    taglineTail=""
    primaryHref="https://toolbox.ibe.engineering/toolbox"
    primaryLabel="Open the Toolbox"
    secondaryHref="mailto:info@ibe.engineering?subject=Toolbox%20question"
    secondaryLabel="Talk to our engineers"
  />
</Base>

<style>
  .section__heading {
    margin-top: var(--s-2);
    margin-bottom: var(--s-8);
    max-width: 28ch;
  }

  .screenshot-ph {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    width: 100%;
    border: 1px dashed var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-surface-alt);
  }

  .screenshot-ph__label {
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-muted);
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-6);
  }

  .missing,
  .pricing {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--s-10);
    align-items: start;
  }

  .missing .section__heading,
  .pricing .section__heading {
    margin-bottom: 0;
  }

  .missing__copy,
  .pricing__copy {
    display: grid;
    gap: var(--s-5);
  }

  .pricing__copy .btn {
    justify-self: start;
  }

  .pricing a:not(.btn) {
    color: var(--color-accent);
    font-weight: var(--fw-medium);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-6);
  }

  .faq-item {
    padding: var(--s-6);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }

  .faq-item h3 {
    margin-bottom: var(--s-3);
    font-size: var(--fs-h3);
  }

  .faq-item p {
    color: var(--color-ink-muted);
    line-height: var(--lh-body);
  }

  @media (max-width: 980px) {
    .tools-grid,
    .faq-grid,
    .missing,
    .pricing {
      grid-template-columns: 1fr;
    }
  }
</style>
