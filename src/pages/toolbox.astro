---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Tile from '../components/Tile.astro';
import CtaStrip from '../components/CtaStrip.astro';

const tools = [
  {
    title: 'Integrat3D Studio',
    status: 'Live',
    body: 'Sketch a floor plan, get a 3D preview, framing plan, full PDF set, and a Revit-ready bundle. Permit-ready outputs without the Revit learning curve.',
    bullets: [
      'Drag-and-draw walls, doors, windows',
      '3D preview as you sketch',
      'PDF plan set + Revit bundle export',
    ],
  },
  {
    title: 'Project Builder',
    status: 'Coming soon',
    body: 'Set up structured projects that every other tool attaches to. One source of truth for levels, scopes, deliverables, and exports.',
  },
  {
    title: 'PDF Floor Plan Importer',
    status: 'Coming soon',
    body: 'Drop in an existing PDF set and get a parsed model back — walls, doors, dimensions, room labels, ready to refine in Integrat3D Studio.',
  },
];

const faq = [
  {
    q: 'Does the Toolbox replace an engineer?',
    a: 'No. The Toolbox speeds up modeling, coordination, and early-stage deliverables. Engineering judgment, code review, and stamped documents still require qualified professionals.',
  },
  {
    q: 'What outputs does Integrat3D Studio generate?',
    a: 'Integrat3D Studio generates floor plans, framing layouts, PDF exports, 3D previews, and Revit-ready bundles.',
  },
  {
    q: 'Who is the Toolbox for?',
    a: 'The Toolbox is built for AEC firms, remodelers, builders, estimators, and designers who need faster building-design workflows without living inside Revit full time.',
  },
  {
    q: 'Can I export to Revit?',
    a: 'Yes. The Toolbox is designed around Revit-native workflows and exports.',
  },
];
---

<Base
  title="IBE Toolbox | Building design and Revit export tools"
  description="Sketch floor plans, generate framing layouts, preview buildings in 3D, and export Revit-ready building packages with the IBE Toolbox."
>
  <Hero
    eyebrow="The IBE Toolbox"
    headlineLead="Pro-grade building tools, "
    underlinedWord="on demand."
    headlineTail=""
    sub="Browser-based building-design workflows for AEC firms, remodelers, and builders. Sketch floor plans, preview designs in 3D, and export Revit-ready deliverables."
    primaryHref="https://toolbox.ibe.engineering/toolbox"
    primaryLabel="Login"
    secondaryHref="https://toolbox.ibe.engineering/sign-up"
    secondaryLabel="Create account"
  />

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">What's inside</span>
      <h2 class="section__heading">Built from real coordination workflows.</h2>
      <div class="tools-grid">
        {tools.map((t) => (
          <Tile
            title={t.title}
            status={t.status}
            body={t.body}
            bullets={t.bullets}
            variant="tool"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container faq">
      <span class="eyebrow">Toolbox FAQ</span>
      <h2 class="section__heading">Questions about the software.</h2>

      <div class="faq-grid">
        {faq.map((item) => (
          <article class="faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaStrip
    taglineLead="Pro-grade. "
    taglineWord="On demand."
    taglineTail=""
    primaryHref="https://toolbox.ibe.engineering/toolbox"
    primaryLabel="Login"
    secondaryHref="https://toolbox.ibe.engineering/sign-up"
    secondaryLabel="Create account"
  />
</Base>

<style>
  .section__heading {
    margin-top: var(--s-2);
    margin-bottom: var(--s-8);
    max-width: 28ch;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-6);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-6);
  }

  .faq-item {
    padding: var(--s-6);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-surface-alt);
  }

  .faq-item h3 {
    margin-bottom: var(--s-3);
    font-size: var(--fs-h3);
  }

  .faq-item p {
    color: var(--color-ink-muted);
    line-height: var(--lh-body);
  }

  @media (max-width: 980px) {
    .tools-grid,
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
