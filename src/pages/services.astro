---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CtaStrip from '../components/CtaStrip.astro';

const designServices = [
  'Permit-ready design sets',
  'For-construction coordinated sets',
  'Fully coordinated BIM/Revit workflows',
  'HVAC design',
  'Plumbing design',
  'Revit-native deliverables',
];

const coordinationServices = [
  'Single-trade coordination',
  'Overall project coordination management',
  'BIM coordination',
  'Clash detection and resolution',
  'Construction coordination support',
  'Design-assist coordination workflows',
];

const extendedServices = [
  'Early-stage estimating support',
  'Fabrication coordination and spooling support',
  'Digital twins and model environments',
  'Augmented reality field workflows',
  'Material takeoffs and workflow automation',
  'Constructability-focused workflow optimization',
];
---

<Base
  title="IBE Services | Coordinated engineering and BIM workflows"
  description="Coordinated HVAC, plumbing, BIM, Revit, fabrication, and constructability-focused engineering workflows built around field installation efficiency."
>
  <Hero
    eyebrow="Coordinated engineering services"
    headlineLead="Engineering designed for "
    underlinedWord="installability."
    headlineTail=""
    sub="IBE provides HVAC design, plumbing design, BIM coordination, and Revit-native workflows built around one goal: making projects easier to coordinate, easier to build, and easier to revise in the field."
    primaryHref="mailto:info@ibe.engineering?subject=Engineering%20services%20inquiry"
    primaryLabel="Talk to our engineers"
    secondaryHref="mailto:info@ibe.engineering?subject=Capabilities%20sheet%20request"
    secondaryLabel="Request capabilities sheet"
  />

  <section class="section section--alt">
    <div class="container philosophy-grid">
      <article>
        <span class="eyebrow">Coordination-first</span>
        <h2>Built around reducing friction in the field.</h2>
        <p>
          Every workflow is designed to reduce clashes, revisions, RFIs, install confusion,
          and coordination breakdowns before crews ever arrive onsite.
        </p>
      </article>

      <article>
        <span class="eyebrow">Revit-native</span>
        <h2>Connected models and coordinated deliverables.</h2>
        <p>
          We structure models, layouts, exports, and coordination sets around real-world
          workflows used by engineers, contractors, and coordination teams.
        </p>
      </article>

      <article>
        <span class="eyebrow">Field-oriented</span>
        <h2>Focused on constructability and installability.</h2>
        <p>
          We optimize for sequencing, installation practicality, fabrication coordination,
          and reducing downstream field conflicts.
        </p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container grouped-services">
      <span class="eyebrow">Services</span>
      <h2 class="section__heading">Coordinated engineering and workflow support.</h2>

      <div class="service-group-grid">
        <article class="service-group">
          <h3>Design</h3>
          <ul>
            {designServices.map((service) => <li>{service}</li>)}
          </ul>
        </article>

        <article class="service-group">
          <h3>Coordination</h3>
          <ul>
            {coordinationServices.map((service) => <li>{service}</li>)}
          </ul>
        </article>

        <article class="service-group">
          <h3>Extended services</h3>
          <ul>
            {extendedServices.map((service) => <li>{service}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">From design to the field</span>
      <h2 class="section__heading">See how the pieces fit together.</h2>
      <p class="portfolio-intro">Drawing excerpts from our TRW Design work, from permit documentation through detailed coordination. Select an image to view the full-size drawing.</p>
      <div class="portfolio-grid">
        <figure class="portfolio-item">
          <a href="/images/trw-permit-set.webp" aria-label="View the full permit drawing">
            <img class="portfolio-item__media" src="/images/trw-permit-set.webp" alt="Permit drawing excerpt showing office HVAC distribution and diffuser schedules" width="1920" height="892" loading="lazy" decoding="async" />
          </a>
          <figcaption>Permit set · HVAC design</figcaption>
        </figure>
        <figure class="portfolio-item">
          <a href="/images/trw-construction-set.webp" aria-label="View the full construction drawing">
            <img class="portfolio-item__media" src="/images/trw-construction-set.webp" alt="For-construction drawing excerpt with routed building systems and installation notes" width="1920" height="1003" loading="lazy" decoding="async" />
          </a>
          <figcaption>For-construction set · Detailed documentation</figcaption>
        </figure>
        <figure class="portfolio-item">
          <a href="/images/trw-coordinated-set.webp" aria-label="View the full coordinated drawing">
            <img class="portfolio-item__media" src="/images/trw-coordinated-set.webp" alt="Coordinated plan showing color-coded ductwork and piping with elevation annotations" width="1920" height="1173" loading="lazy" decoding="async" />
          </a>
          <figcaption>Fully coordinated set · Systems and elevations</figcaption>
        </figure>
      </div>
      <p class="portfolio-note">
        Want to see relevant examples for your project type?
        <a href="mailto:info@ibe.engineering?subject=Portfolio%20request">Ask for our portfolio</a>.
      </p>
      <div class="portfolio-grid portfolio-grid--photos">
        <figure class="portfolio-item">
          <img class="portfolio-item__media portfolio-item__media--photo" src="/images/trw-spooling.webp" alt="Fabricated metal pipe spools with flanged connections arranged in a workshop" width="1200" height="799" loading="lazy" decoding="async" />
          <figcaption>Fabrication and spooling support</figcaption>
        </figure>
        <figure class="portfolio-item">
          <img class="portfolio-item__media portfolio-item__media--photo" src="/images/trw-ar.webp" alt="Two workers viewing a building systems model on a tablet at a jobsite" width="1200" height="800" loading="lazy" decoding="async" />
          <figcaption>Model visualization in the field</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container narrative-grid">
      <div>
        <span class="eyebrow">Built in-house</span>
        <h2>We build the software behind the work.</h2>
      </div>

      <div class="narrative-copy">
        <p>
          IBE develops its own custom software — design and extraction workflows, Revit
          automation, reality capture, and coordination tooling — built to streamline the
          repetitive parts of real engineering projects.
        </p>

        <p>
          That technology stays under the hood of every engagement: faster plan sets, cleaner
          models, fewer redraws — with engineering judgment always in front of it.
        </p>

        <p>
          Select tools are in private beta with partner teams. Ask us about early access.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container pricing-grid">
      <div>
        <span class="eyebrow">Engineering philosophy</span>
        <h2>Well-coordinated projects create measurable field value.</h2>
      </div>

      <div>
        <p>
          IBE primarily works through fixed-fee coordination and engineering workflows focused
          on reducing friction during installation and construction.
        </p>

        <p>
          Our philosophy is simple: coordinated documentation and constructability-focused
          workflows should improve field execution substantially more than the coordination cost itself.
        </p>

        <p>
          Better documentation, better coordination, and better constructability planning reduce
          downstream revisions, confusion, delays, and install inefficiencies across the project lifecycle.
        </p>
      </div>
    </div>
  </section>

  <CtaStrip
    taglineLead="Coordinated "
    taglineWord="workflows."
    taglineTail=" Better projects in the field."
    primaryHref="mailto:info@ibe.engineering?subject=Engineering%20services%20inquiry"
    primaryLabel="Talk to our engineers"
    secondaryHref="mailto:info@ibe.engineering?subject=Capabilities%20sheet%20request"
    secondaryLabel="Request capabilities sheet"
  />
</Base>

<style>
  /* Keep the marker clear of the leading i dot and the y descender. */
  :global(.hero .hero__headline .oval-wrap) {
    padding: 0.24em 0.45em 0.18em;
  }

  .philosophy-grid,
  .service-group-grid {
    display: grid;
    gap: var(--s-6);
  }

  .philosophy-grid,
  .service-group-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .section__heading {
    margin-top: var(--s-2);
    margin-bottom: var(--s-8);
    max-width: 28ch;
  }

  .service-group,
  .philosophy-grid article {
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    padding: var(--s-6);
    background: white;
  }

  .service-group h3 {
    margin-bottom: var(--s-5);
  }

  .philosophy-grid article > * + * {
    margin-top: var(--s-4);
  }

  .philosophy-grid h2 {
    font-size: clamp(1.5rem, 2.2vw, 1.875rem);
  }

  .philosophy-grid p {
    color: var(--color-ink-muted);
  }

  .service-group ul {
    display: grid;
    gap: var(--s-3);
    padding-left: 1.1rem;
    color: var(--color-ink-muted);
  }

  .narrative-grid,
  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--s-10);
    align-items: start;
  }

  .narrative-copy,
  .pricing-grid div:last-child {
    display: grid;
    gap: var(--s-5);
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-6);
  }

  .portfolio-item {
    display: grid;
    gap: var(--s-3);
  }

  .portfolio-item__media {
    aspect-ratio: 3 / 2;
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-rule);
    background: var(--color-bg);
  }

  .portfolio-item figcaption {
    font-size: var(--fs-small);
    color: var(--color-ink-muted);
  }

  .portfolio-note {
    margin-top: var(--s-6);
    color: var(--color-ink-muted);
  }

  .portfolio-grid--photos {
    grid-template-columns: repeat(2, 1fr);
    margin-top: var(--s-10);
  }

  .portfolio-item__media--photo {
    object-fit: cover;
  }

  .portfolio-intro {
    margin-top: calc(-1 * var(--s-4));
    margin-bottom: var(--s-8);
    color: var(--color-ink-muted);
  }

  .portfolio-note a {
    color: var(--color-accent);
    font-weight: var(--fw-medium);
  }

  @media (max-width: 980px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 980px) {
    .philosophy-grid,
    .service-group-grid,
    .narrative-grid,
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
