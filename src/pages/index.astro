---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StatPanel from '../components/StatPanel.astro';
import Tile from '../components/Tile.astro';
import CtaStrip from '../components/CtaStrip.astro';

const faq = [
  {
    q: 'What engineering services does IBE provide?',
    a: 'IBE provides HVAC design, plumbing design, BIM coordination, clash detection, and Revit-native coordination deliverables for AEC firms and construction teams.',
  },
  {
    q: 'Does IBE also provide software tools?',
    a: 'Yes. The IBE Toolbox contains browser-based tools developed from our own internal coordination workflows.',
  },
  {
    q: 'Who do you work with?',
    a: 'We work with architects, contractors, developers, remodelers, and AEC firms that need coordinated engineering and BIM deliverables.',
  },
  {
    q: 'Can I hire IBE without using the Toolbox?',
    a: 'Yes. Engineering services and software access are separate offerings.',
  },
];
---

<Base
  title="IBE | HVAC, Plumbing, BIM Coordination, and Building Design Tools"
  description="Integrated Building Engineering provides HVAC, plumbing, BIM coordination, and browser-based building design tools for AEC firms and construction teams."
>
  <Hero
    eyebrow="Integrated building engineering"
    headlineLead="Coordinated HVAC, plumbing, and BIM design — plus the "
    underlinedWord="tools"
    headlineTail=" behind the workflow."
    sub="IBE provides engineering services for AEC firms and browser-based building-design tools for teams that need faster plan sets, 3D previews, and Revit-ready outputs."
    primaryHref="mailto:info@ibe.engineering?subject=Project%20inquiry"
    primaryLabel="Talk to our engineers"
    secondaryHref="/toolbox"
    secondaryLabel="Explore the Toolbox"
  />

  <section class="section section--alt">
    <div class="container split-grid">
      <a class="path-card" href="/services">
        <span class="eyebrow">Services</span>
        <h2>I need engineering services.</h2>
        <p>HVAC design, plumbing design, BIM coordination, clash detection, and Revit-native deliverables.</p>
        <span class="path-card__more">See services <span aria-hidden="true">→</span></span>
      </a>

      <a class="path-card" href="/toolbox">
        <span class="eyebrow">Software</span>
        <h2>I want to use the Toolbox.</h2>
        <p>Browser-based tools for floor plans, 3D previews, framing layouts, and Revit-ready exports.</p>
        <span class="path-card__more">Explore the Toolbox <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <section class="section social-proof">
    <div class="container">
      <p class="social-proof__lead">
        Built and used on real coordinated projects across New Hampshire and the Northeast.
      </p>
      {/* TODO(Tyler): add real client/partner logos here when cleared to publish. These are
          true affiliations and capabilities in the meantime — not placeholders. */}
      <ul class="social-proof__logos" aria-label="Affiliations and capabilities">
        <li class="social-proof__logo">ASHRAE</li>
        <li class="social-proof__logo">ACE Mentor NH</li>
        <li class="social-proof__logo">Revit-native BIM</li>
        <li class="social-proof__logo">HVAC + Plumbing</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container faq">
      <span class="eyebrow">Services FAQ</span>
      <h2 class="section__heading">Questions about engineering services.</h2>

      <div class="faq-grid">
        {faq.map((item) => (
          <article class="faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaStrip
    taglineLead="Plan "
    taglineWord="Well."
    taglineTail=" Build Well."
    primaryHref="https://toolbox.ibe.engineering/toolbox"
    primaryLabel="Open the Toolbox"
    secondaryHref="mailto:info@ibe.engineering?subject=Project%20inquiry"
    secondaryLabel="Talk to our engineers"
  />
</Base>

<style>
  .split-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-6);
  }

  .path-card {
    padding: var(--s-8);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-rule);
    background: var(--color-bg);
    text-decoration: none;
    color: inherit;
    display: grid;
    gap: var(--s-2);
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .path-card:hover,
  .path-card:focus-visible {
    transform: translateY(-2px);
    border-color: var(--color-ink);
  }

  .path-card h2 {
    margin: var(--s-2) 0 var(--s-1);
  }

  .path-card p {
    color: var(--color-ink-muted);
    line-height: var(--lh-body);
  }

  .path-card__more {
    margin-top: var(--s-3);
    font-weight: var(--fw-medium);
    color: var(--color-accent);
  }

  .social-proof {
    padding-block: clamp(var(--s-8), 5vw, var(--s-12));
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }

  .social-proof__lead {
    text-align: center;
    color: var(--color-ink-muted);
    max-width: none;
    margin-bottom: var(--s-6);
  }

  .social-proof__logos {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--s-8);
  }

  .social-proof__logo {
    font-weight: var(--fw-bold);
    font-size: var(--fs-h3);
    color: var(--color-ink);
    opacity: 0.45;
    letter-spacing: -0.01em;
  }

  .section__heading {
    margin-top: var(--s-2);
    margin-bottom: var(--s-8);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-6);
  }

  .faq-item {
    padding: var(--s-6);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-surface-alt);
  }

  .faq-item h3 {
    margin-bottom: var(--s-3);
  }

  .faq-item p {
    color: var(--color-ink-muted);
    line-height: var(--lh-body);
  }

  @media (max-width: 760px) {
    .split-grid,
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
