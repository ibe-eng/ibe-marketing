---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CtaStrip from '../components/CtaStrip.astro';

const faq = [
  {
    q: 'What engineering services does IBE provide?',
    a: 'IBE provides HVAC design, plumbing design, BIM coordination, clash detection, and Revit-native coordination deliverables for AEC firms and construction teams.',
  },
  {
    q: 'Does IBE build its own software?',
    a: 'Yes. We develop custom software and automation — from Revit workflows to design and extraction tools — that streamline our own coordination work. Select tools are in private beta with partner teams.',
  },
  {
    q: 'Who do you work with?',
    a: 'We work with architects, contractors, developers, remodelers, and AEC firms that need coordinated engineering and BIM deliverables.',
  },
  {
    q: 'Where does IBE work?',
    a: "We're based in New Hampshire and serve AEC firms and builders across the Northeast, with Revit-native remote coordination available beyond that.",
  },
];
---

<Base
  title="IBE | HVAC, Plumbing, and BIM Coordination Engineering"
  description="Integrated Building Engineering provides coordinated HVAC design, plumbing design, and BIM coordination for AEC firms and construction teams — streamlined by custom software and automation built in-house."
>
  <Hero
    eyebrow="HVAC &amp; plumbing engineering"
    headlineLead="Field-ready design &amp;<br />coordination for<br />jobsite "
    underlinedWord="success."
    headlineTail=""
    sub="Connected design and coordination from the first model to construction. HVAC, plumbing, and coordinated build sets that help teams reduce rework and plan installation."
    primaryHref="mailto:info@ibe.engineering?subject=Project%20inquiry"
    primaryLabel="Start your project"
  >
    <figure slot="visual" class="hero-illustration">
      <a href="/images/trw-coordination-model.webp" aria-label="View the full coordination model image">
        <img src="/images/trw-coordination-model.webp" alt="3D coordination model showing pipework, equipment, and overhead structure" width="960" height="1442" fetchpriority="high" />
      </a>
    </figure>
  </Hero>

  <section class="section coordination-context">
    <div class="container outcome-intro">
      <img src="/images/trw-coordination-context.webp" alt="Illustration of a construction team reviewing conflicting building-system routes" width="900" height="900" loading="lazy" />
      <div>
        <h2>The cost of uncoordinated design.</h2>
        <div class="coordination-point"><h3>Field conflicts become rework.</h3><p>Review routes, clearances, and installation access before crews arrive.</p></div>
        <div class="coordination-point"><h3>Late answers disrupt schedules.</h3><p>Resolve coordination questions during design so teams can plan the work with confidence.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Design + coordination</span>
      <h2 class="section__heading">One workflow, from design to the field.</h2>
      <div class="offering-grid">
        <article class="offering-card">
          <img src="/images/trw-spooling.webp" alt="Fabricated pipe spools arranged in a workshop" width="1200" height="799" loading="lazy" />
          <div class="offering-card__copy">
            <span class="eyebrow">Expanded services</span>
            <h3>Fabrication &amp; spooling</h3>
            <p>Detailed models and spool documentation to support off-site fabrication and practical installation sequences.</p>
            <a href="/services" class="path-card__more">Explore fabrication support →</a>
          </div>
        </article>
        <article class="offering-card">
          <img src="/images/trw-construction-set.webp" alt="Detailed HVAC construction drawing" width="1920" height="1003" loading="lazy" />
          <div class="offering-card__copy">
            <span class="eyebrow">Core offering</span>
            <h3>Coordinated build sets</h3>
            <p>HVAC and plumbing design, construction documents, and coordinated models built around the needs of your project.</p>
            <a href="#design-tiers" class="path-card__more">Compare design tiers →</a>
          </div>
        </article>
        <article class="offering-card">
          <img src="/images/trw-ar.webp" alt="Workers reviewing a building model on a tablet" width="1200" height="800" loading="lazy" />
          <div class="offering-card__copy">
            <span class="eyebrow">Expanded services</span>
            <h3>AR jobsite integration</h3>
            <p>Model visualization and augmented reality workflows that help teams understand the design where the work happens.</p>
            <a href="/services" class="path-card__more">Explore field workflows →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--dark" id="design-tiers">
    <div class="container">
      <span class="eyebrow">Choose the right level of detail</span>
      <h2 class="section__heading">Our coordinated design tiers.</h2>
      <div class="tier-grid">
        {[
          {number: '1', title: 'Permit design', image: 'permit', height: 892, text: 'Documentation for permitting, with HVAC and plumbing planned around architecture and structure. Further coordination with other trades happens in the field.'},
          {number: '2', title: 'For construction', image: 'construction', height: 1003, text: 'Detailed construction documents with major systems coordinated across trades. Field coordination remains part of installation.'},
          {number: '3', title: 'Fully coordinated', image: 'coordinated', height: 1173, text: 'Detailed system routing and elevations supported by 3D coordination, with conflicts reviewed before construction.'},
        ].map((tier) => (
          <article class="tier-card">
            <span class="eyebrow">Tier {tier.number}</span>
            <h3>{tier.title}</h3>
            <a href={`/images/trw-${tier.image}-set.webp`} aria-label={`View full ${tier.title.toLowerCase()} drawing`}>
              <img src={`/images/trw-${tier.image}-set.webp`} alt={`${tier.title} drawing excerpt from TRW Design`} width="1920" height={tier.height} loading="lazy" />
            </a>
            <p>{tier.text}</p>
          </article>
        ))}
      </div>
      <div class="estimating-strip">
        <div class="estimating-copy"><span class="eyebrow">Additional service</span><h3>Design estimating</h3><p>Model-based quantities and early estimating support help connect design decisions with construction cost, so scope and budget can develop together.</p></div>
        <figure><img src="/images/trw-estimating.webp" alt="Concept illustration of a building model, quantity takeoff, and estimate sheets" width="900" height="623" loading="lazy" /><figcaption>Estimating workflow illustration.</figcaption></figure>
      </div>
      <div class="tier-cta"><a href="/contact" class="btn btn--primary">Contact us to start your project</a></div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">Outcomes</span>
      <h2 class="section__heading">Built around a better day in the field.</h2>
      <div class="outcome-grid">
        <article><h3>Resolve conflicts early.</h3><p>Review routes, clearances, and access in the model before installation begins.</p></article>
        <article><h3>Make the details clear.</h3><p>Give teams coordinated views and documentation they can use to plan and sequence the work.</p></article>
        <article><h3>Keep revisions connected.</h3><p>Use Revit-native workflows and repeatable checks to carry changes through the design.</p></article>
      </div>
      <a class="path-card__more" href="/about">How we work →</a>
    </div>
  </section>

  <section class="section social-proof">
    <div class="container">
      <p class="social-proof__lead">
        Built and used on real coordinated projects across New Hampshire and the Northeast.
      </p>
      {/* TODO(Tyler): add real client/partner logos here when cleared to publish. These are
          true affiliations and capabilities in the meantime — not placeholders. */}
      <ul class="social-proof__logos" aria-label="Affiliations and capabilities">
        <li class="social-proof__logo">ASHRAE</li>
        <li class="social-proof__logo">ACE Mentor NH</li>
        <li class="social-proof__logo">Revit-native BIM</li>
        <li class="social-proof__logo">HVAC + Plumbing</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container faq">
      <span class="eyebrow">Services FAQ</span>
      <h2 class="section__heading">Questions about engineering services.</h2>

      <div class="faq-grid">
        {faq.map((item) => (
          <article class="faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaStrip
    taglineLead="Plan Well. "
    taglineWord="Build Well."
    taglineTail=""
    primaryHref="mailto:info@ibe.engineering?subject=Project%20inquiry"
    primaryLabel="Talk to our engineers"
    secondaryHref="/contact"
    secondaryLabel="Get in touch"
  />
</Base>

<style>
  .hero-illustration {
    min-width: 0;
    width: min(100%, 360px);
    justify-self: center;
  }

  .hero-illustration img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-md);
  }

  .hero-illustration figcaption {
    margin-top: var(--s-3);
    font-size: var(--fs-small);
    color: var(--color-ink-muted);
  }

  .offering-grid, .tier-grid, .outcome-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6);
  }
  .offering-card {
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-surface-alt);
    display: grid;
    grid-template-rows: auto 1fr;
  }
  .offering-card > img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .offering-card__copy {
    padding: var(--s-6);
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--s-3);
  }
  .offering-card p, .outcome-grid p, .outcome-intro p { color: var(--color-ink-muted); }
  .tier-card { min-width: 0; display: grid; align-content: start; gap: var(--s-6); padding: var(--s-8); background: #242424; border-radius: 18px; }
  .tier-card .eyebrow, .estimating-copy .eyebrow { width: fit-content; padding: var(--s-2) var(--s-3); border-radius: var(--radius-sm); background: var(--color-accent); color: white; }
  .tier-card h3, .estimating-copy h3 { font-size: clamp(1.4rem, 2vw, 1.875rem); }
  .tier-card img { width: 100%; height: auto; aspect-ratio: 6 / 5; object-fit: cover; display: block; border-radius: 14px; }
  .tier-card a { align-self: start; }
  .tier-card p { color: #ccc; }
  .outcome-intro { display: grid; grid-template-columns: 1fr 2fr; gap: var(--s-10); align-items: center; }
  .outcome-intro h2 { margin-top: var(--s-3); }
  .outcome-grid { margin-bottom: var(--s-8); }
  .outcome-grid h3 { margin-bottom: var(--s-3); }
  .estimating-strip { display: grid; grid-template-columns: 2fr 1fr; gap: var(--s-6); margin-top: var(--s-6); }
  .estimating-copy { padding: var(--s-8); border-radius: 18px; background: #242424; }
  .estimating-copy h3 { margin-block: var(--s-6); }
  .estimating-copy p { color: #ccc; }
  .estimating-strip figure { min-width: 0; }
  .estimating-strip img { display: block; width: 100%; height: auto; border-radius: 18px; }
  .estimating-strip figcaption { font-size: var(--fs-small); color: #ccc; margin-top: var(--s-2); }
  .tier-cta { text-align: center; margin-top: var(--s-10); }
  .tier-cta .btn { padding: var(--s-5) var(--s-8); }
  .outcome-intro > img { width: 100%; height: auto; border-radius: 18px; }
  .coordination-point { margin-top: var(--s-6); padding-top: var(--s-6); }
  .coordination-point + .coordination-point { border-top: 1px solid var(--color-rule); }
  .coordination-point h3 { color: var(--color-accent); font-size: clamp(1.25rem, 2.5vw, 1.875rem); margin-bottom: var(--s-3); }
  :global(.hero--visual .hero__copy) { text-align: center; justify-items: center; }
  :global(.hero--visual .hero__ctas) { justify-content: center; }
  :global(.hero--visual .hero__copy > .eyebrow) { padding: var(--s-2) var(--s-3); background: var(--color-surface-alt); border-radius: var(--radius-sm); }
  @media (min-width: 980px) {
    :global(.hero--visual .hero__inner) { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
    :global(.hero--visual .hero__headline) { font-size: clamp(2.5rem, 3.8vw, 3.5rem); }
  }
  #design-tiers { scroll-margin-top: 90px; }
  @media (max-width: 980px) {
    .offering-grid, .tier-grid, .outcome-grid, .outcome-intro { grid-template-columns: 1fr; }
    .estimating-strip { grid-template-columns: 1fr; }
    .tier-card, .estimating-copy { padding: var(--s-6); }
  }

  .path-card__more {
    margin-top: var(--s-3);
    font-weight: var(--fw-medium);
    color: var(--color-accent);
  }

  .social-proof {
    padding-block: clamp(var(--s-8), 5vw, var(--s-12));
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }

  .social-proof__lead {
    text-align: center;
    color: var(--color-ink-muted);
    max-width: none;
    margin-bottom: var(--s-6);
  }

  .social-proof__logos {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--s-8);
  }

  .social-proof__logo {
    font-weight: var(--fw-bold);
    font-size: var(--fs-h3);
    color: var(--color-ink-muted);
    letter-spacing: -0.01em;
  }

  .section__heading {
    margin-top: var(--s-2);
    margin-bottom: var(--s-8);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-6);
  }

  .faq-item {
    padding: var(--s-6);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-surface-alt);
  }

  .faq-item h3 {
    margin-bottom: var(--s-3);
  }

  .faq-item p {
    color: var(--color-ink-muted);
    line-height: var(--lh-body);
  }

  @media (max-width: 760px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
