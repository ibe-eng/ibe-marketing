---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StatPanel from '../components/StatPanel.astro';
import Tile from '../components/Tile.astro';
import CtaStrip from '../components/CtaStrip.astro';

const faq = [
  {
    q: 'What engineering services does IBE provide?',
    a: 'IBE provides HVAC design, plumbing design, BIM coordination, clash detection, and Revit-native coordination deliverables for AEC firms and construction teams.',
  },
  {
    q: 'Does IBE build its own software?',
    a: 'Yes. We develop custom software and automation — from Revit workflows to design and extraction tools — that streamline our own coordination work. Select tools are in private beta with partner teams.',
  },
  {
    q: 'Who do you work with?',
    a: 'We work with architects, contractors, developers, remodelers, and AEC firms that need coordinated engineering and BIM deliverables.',
  },
  {
    q: 'Where does IBE work?',
    a: "We're based in New Hampshire and serve AEC firms and builders across the Northeast, with Revit-native remote coordination available beyond that.",
  },
];
---

<Base
  title="IBE | HVAC, Plumbing, and BIM Coordination Engineering"
  description="Integrated Building Engineering provides coordinated HVAC design, plumbing design, and BIM coordination for AEC firms and construction teams — streamlined by custom software and automation built in-house."
>
  <Hero
    eyebrow="Integrated building engineering"
    headlineLead=""
    underlinedWord="Coordinated"
    headlineTail=" HVAC, plumbing, and BIM design — built for the field."
    sub="IBE is the engineering practice behind coordinated, constructable buildings — HVAC and plumbing design, BIM coordination, and Revit-native deliverables, streamlined by software we build in-house."
    primaryHref="mailto:info@ibe.engineering?subject=Project%20inquiry"
    primaryLabel="Talk to our engineers"
    secondaryHref="/services"
    secondaryLabel="See services"
  />

  <section class="section section--alt">
    <div class="container split-grid">
      <a class="path-card" href="/services">
        <span class="eyebrow">Services</span>
        <h2>I need engineering services.</h2>
        <p>HVAC design, plumbing design, BIM coordination, clash detection, and Revit-native deliverables.</p>
        <span class="path-card__more">See services <span aria-hidden="true">→</span></span>
      </a>

      <a class="path-card" href="/about">
        <span class="eyebrow">Technology</span>
        <h2>Engineering at the cutting edge.</h2>
        <p>Custom software, Revit automation, reality capture, and streamlined design-to-field workflows — built in-house and proven on real coordinated projects.</p>
        <span class="path-card__more">How we work <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <section class="section social-proof">
    <div class="container">
      <p class="social-proof__lead">
        Built and used on real coordinated projects across New Hampshire and the Northeast.
      </p>
      {/* TODO(Tyler): add real client/partner logos here when cleared to publish. These are
          true affiliations and capabilities in the meantime — not placeholders. */}
      <ul class="social-proof__logos" aria-label="Affiliations and capabilities">
        <li class="social-proof__logo">ASHRAE</li>
        <li class="social-proof__logo">ACE Mentor NH</li>
        <li class="social-proof__logo">Revit-native BIM</li>
        <li class="social-proof__logo">HVAC + Plumbing</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container faq">
      <span class="eyebrow">Services FAQ</span>
      <h2 class="section__heading">Questions about engineering services.</h2>

      <div class="faq-grid">
        {faq.map((item) => (
          <article class="faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaStrip
    taglineLead="Plan "
    taglineWord="Well."
    taglineTail=" Build Well."
    primaryHref="mailto:info@ibe.engineering?subject=Project%20inquiry"
    primaryLabel="Talk to our engineers"
    secondaryHref="/contact"
    secondaryLabel="Get in touch"
  />
</Base>

<style>
  .split-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-6);
  }

  .path-card {
    padding: var(--s-8);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-rule);
    background: var(--color-bg);
    text-decoration: none;
    color: inherit;
    display: grid;
    gap: var(--s-2);
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .path-card:hover,
  .path-card:focus-visible {
    transform: translateY(-2px);
    border-color: var(--color-ink);
  }

  .path-card h2 {
    margin: var(--s-2) 0 var(--s-1);
  }

  .path-card p {
    color: var(--color-ink-muted);
    line-height: var(--lh-body);
  }

  .path-card__more {
    margin-top: var(--s-3);
    font-weight: var(--fw-medium);
    color: var(--color-accent);
  }

  .social-proof {
    padding-block: clamp(var(--s-8), 5vw, var(--s-12));
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }

  .social-proof__lead {
    text-align: center;
    color: var(--color-ink-muted);
    max-width: none;
    margin-bottom: var(--s-6);
  }

  .social-proof__logos {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--s-8);
  }

  .social-proof__logo {
    font-weight: var(--fw-bold);
    font-size: var(--fs-h3);
    color: var(--color-ink);
    opacity: 0.45;
    letter-spacing: -0.01em;
  }

  .section__heading {
    margin-top: var(--s-2);
    margin-bottom: var(--s-8);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-6);
  }

  .faq-item {
    padding: var(--s-6);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-surface-alt);
  }

  .faq-item h3 {
    margin-bottom: var(--s-3);
  }

  .faq-item p {
    color: var(--color-ink-muted);
    line-height: var(--lh-body);
  }

  @media (max-width: 760px) {
    .split-grid,
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
