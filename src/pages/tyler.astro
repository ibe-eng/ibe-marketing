---
const destination =
  '/?utm_source=business_card&utm_medium=qr&utm_campaign=business_card&utm_content=tyler_wilson';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href="https://ibe.engineering/" />
    <title>Integrated Building Engineering</title>
  </head>
  <body>
    <p>
      Continuing to <a href={destination}>Integrated Building Engineering</a>…
    </p>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </body>
</html>
