---
const destination = '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://ibe.engineering/" />
    <title>Integrated Building Engineering</title>
  </head>
  <body>
    <p>
      Continuing to <a href={destination}>Integrated Building Engineering</a>…
    </p>
    <script is:inline define:vars={{ destination }}>
      try {
        sessionStorage.setItem(
          'ibe_qr_attribution',
          JSON.stringify({
            source: 'business_card',
            medium: 'qr',
            campaign: 'business_card',
            card: 'tyler_wilson',
            scanned_at: Date.now(),
          })
        );
      } catch (_) {
        // If storage is unavailable, still complete the redirect.
      }

      window.location.replace(destination);
    </script>
  </body>
</html>
