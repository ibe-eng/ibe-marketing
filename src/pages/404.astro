---
// F121 (usability audit): GitHub Pages serves dist/404.html for any unknown
// path, so a missing page keeps the IBE header, footer and a way back.
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found — IBE"
  description="That page isn't on ibe.engineering."
  noindex
>
  <section class="section">
    <div class="container policy">
      <span class="eyebrow">404</span>
      <h1>We can't find that page.</h1>
      <p>The link may be old, or the address may have a typo.</p>
      <p>
        <a href="/" class="btn btn--primary">Go to the home page</a>
        <a href="/contact" class="btn btn--secondary">Contact us</a>
      </p>
    </div>
  </section>
</Base>
