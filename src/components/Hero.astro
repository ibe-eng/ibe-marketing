---
import RedOvalUnderline from './RedOvalUnderline.astro';

interface Props {
  eyebrow: string;
  /** Plain text before the underlined word. */
  headlineLead: string;
  /** The single word that gets the red oval underline. */
  underlinedWord: string;
  /** Plain text after the underlined word. */
  headlineTail: string;
  sub: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  eyebrow,
  headlineLead,
  underlinedWord,
  headlineTail,
  sub,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
} = Astro.props;
---

<section class="hero">
  <div class="container hero__inner">
    <span class="eyebrow">{eyebrow}</span>
    <h1 class="hero__headline"><Fragment set:html={headlineLead} /><RedOvalUnderline word={underlinedWord} /><Fragment set:html={headlineTail} /></h1>
    <p class="hero__sub">{sub}</p>
    {(primaryHref || secondaryHref) && (
      <div class="hero__ctas">
        {primaryHref && primaryLabel && (
          <a href={primaryHref} class="btn btn--primary" rel="noopener">
            {primaryLabel}
          </a>
        )}
        {secondaryHref && secondaryLabel && (
          <a href={secondaryHref} class="btn btn--secondary">
            {secondaryLabel}
          </a>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(var(--s-12), 7vw, var(--s-16));
    background: var(--color-bg);
  }

  .hero__inner {
    display: grid;
    gap: var(--s-6);
  }

  .hero__headline {
    font-size: var(--fs-hero);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
  }

  .hero__sub {
    font-size: var(--fs-h3);
    color: var(--color-ink-muted);
    line-height: var(--lh-snug);
    max-width: 60ch;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-3);
  }

  .hero__ctas .btn {
    padding: var(--s-4) var(--s-6);
    font-size: var(--fs-body);
  }
</style>
