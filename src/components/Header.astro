---
const navLinks = [
  { href: '/services', label: 'Services' },
  { href: '/toolbox', label: 'Toolbox' },
  { href: '/aec-os', label: 'AEC-OS' },
  { href: 'mailto:info@ibe.engineering?subject=Project%20inquiry', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label="IBE — Integrated Building Engineering home">
      <img
        src="/images/ibe_logo_horiz_white_red.png"
        alt="IBE — Integrat3D Building Engineering"
        width="253"
        height="51"
      />
    </a>
    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a
      href="https://toolbox.ibe.engineering/toolbox"
      class="btn btn--primary site-header__cta"
      rel="noopener"
    >
      Login
    </a>

    <details class="site-header__mobile-menu">
      <summary>Menu</summary>
      <nav aria-label="Mobile primary">
        {navLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
        <a href="https://toolbox.ibe.engineering/toolbox" rel="noopener">Login</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-surface-dark);
    color: var(--color-accent-ink);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    padding-block: var(--s-3);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
  }

  .site-header__brand img {
    height: 41px;
    width: auto;
  }

  .site-header__nav {
    margin-left: auto;
  }

  .site-header__nav ul {
    display: flex;
    gap: var(--s-6);
    list-style: none;
  }

  .site-header__nav a {
    font-weight: var(--fw-medium);
    font-size: var(--fs-small);
    color: rgba(255, 255, 255, 0.85);
    transition: color var(--transition-fast);
  }

  .site-header__nav a:hover {
    color: var(--color-accent-ink);
  }

  .site-header__cta {
    flex-shrink: 0;
  }

  .site-header__mobile-menu {
    display: none;
    position: relative;
    margin-left: auto;
  }

  .site-header__mobile-menu summary {
    list-style: none;
    cursor: pointer;
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: var(--radius-md);
    padding: var(--s-3) var(--s-4);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
  }

  .site-header__mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .site-header__mobile-menu nav {
    position: absolute;
    right: 0;
    top: calc(100% + var(--s-2));
    display: grid;
    min-width: 180px;
    padding: var(--s-3);
    border-radius: var(--radius-md);
    background: var(--color-surface-dark);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
  }

  .site-header__mobile-menu nav a {
    padding: var(--s-3);
    color: white;
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
  }

  /* Buttons (shared) */
  :global(.btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-6);
    border-radius: var(--radius-md);
    font-weight: var(--fw-medium);
    font-size: var(--fs-small);
    line-height: 1;
    border: 2px solid transparent;
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast),
      border-color var(--transition-fast), transform var(--transition-fast);
    text-decoration: none;
  }

  :global(.btn--primary) {
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border-color: var(--color-accent);
  }

  :global(.btn--primary:hover) {
    background: #cc0000;
    border-color: #cc0000;
  }

  :global(.btn--secondary) {
    background: transparent;
    color: var(--color-ink);
    border-color: var(--color-ink);
  }

  :global(.btn--secondary:hover) {
    background: var(--color-ink);
    color: var(--color-accent-ink);
  }

  :global(.section--dark .btn--secondary) {
    color: var(--color-accent-ink);
    border-color: var(--color-accent-ink);
  }

  :global(.section--dark .btn--secondary:hover) {
    background: var(--color-accent-ink);
    color: var(--color-ink);
  }

  @media (max-width: 720px) {
    .site-header__nav,
    .site-header__cta {
      display: none;
    }
    .site-header__mobile-menu {
      display: block;
    }
    .site-header__inner {
      justify-content: space-between;
      gap: var(--s-3);
    }
  }
</style>
