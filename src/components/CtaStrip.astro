---
import RedOvalUnderline from './RedOvalUnderline.astro';

interface Props {
  /** Plain text before the underlined word. */
  taglineLead?: string;
  /** Word to underline (optional). */
  taglineWord?: string;
  /** Plain text after the underlined word. */
  taglineTail?: string;
  /** Or pass full plain tagline (ignored if taglineLead provided). */
  tagline?: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  taglineLead,
  taglineWord,
  taglineTail,
  tagline,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
} = Astro.props;
---

<section class="section section--dark cta-strip">
  <div class="container cta-strip__inner">
    <h2 class="cta-strip__tag">{taglineLead && taglineWord ? (
        <Fragment><Fragment set:html={taglineLead} /><RedOvalUnderline word={taglineWord} /><Fragment set:html={taglineTail} /></Fragment>
      ) : (
        tagline
      )}</h2>
    <div class="cta-strip__ctas">
      <a href={primaryHref} class="btn btn--primary" rel="noopener">{primaryLabel}</a>
      {secondaryHref && secondaryLabel && (
        <a href={secondaryHref} class="btn btn--secondary">{secondaryLabel}</a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-strip__inner {
    display: grid;
    gap: var(--s-8);
    grid-template-columns: 1fr auto;
    align-items: center;
  }

  .cta-strip__tag {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: var(--lh-tight);
    max-width: 18ch;
  }

  .cta-strip__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .cta-strip__ctas .btn {
    padding: var(--s-4) var(--s-6);
    font-size: var(--fs-body);
  }

  @media (max-width: 760px) {
    .cta-strip__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
