---
interface Props {
  word: string;
}
const { word } = Astro.props;
---

<span class="oval-wrap">
  <span class="oval-word">{word}</span>
  <svg
    class="oval-svg"
    viewBox="0 0 300 80"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M 6,35 C 1,12 63,4 150,5 C 241,3 293,10 296,35 C 303,63 258,76 151,75 C 57,78 3,70 4,43 C 4,34 7,29 12,27"
      fill="none"
      stroke="var(--color-accent)"
      vector-effect="non-scaling-stroke"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</span>

<style>
  .oval-wrap {
    position: relative;
    display: inline-block;
    /* Reserve the annotation's space in the line, including at wraps. */
    padding: 0.1em 0.35em;
    white-space: nowrap;
  }

  .oval-word {
    position: relative;
    z-index: 1;
  }

  .oval-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    overflow: visible;
  }

  .oval-svg path {
    /* A bold marker loop with an overlapping finish; scale with the type,
       not with the SVG's horizontal stretch on longer words. */
    stroke-width: clamp(3px, 0.09em, 6px);
  }
</style>
