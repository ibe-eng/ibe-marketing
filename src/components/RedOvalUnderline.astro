---
interface Props {
  word: string;
}
const { word } = Astro.props;
---

<span class="oval-wrap">
  <span class="oval-word">{word}</span>
  <svg
    class="oval-svg"
    viewBox="0 0 300 80"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M 150,4 C 260,4 297,4 297,40 C 297,76 260,76 150,76 C 40,76 3,76 3,40 C 3,4 40,4 150,4 Z"
      fill="none"
      stroke="var(--color-accent)"
      stroke-width="2.5"
      vector-effect="non-scaling-stroke"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</span>

<style>
  .oval-wrap {
    position: relative;
    display: inline-block;
    /* Reserve the annotation's space in the line, including at wraps. */
    padding: 0.1em 0.35em;
    white-space: nowrap;
  }

  .oval-word {
    position: relative;
    z-index: 1;
  }

  .oval-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
</style>
