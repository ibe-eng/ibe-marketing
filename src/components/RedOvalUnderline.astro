---
interface Props {
  word: string;
}
const { word } = Astro.props;
---

<span class="oval-wrap">
  <span class="oval-word">{word}</span>
  <svg
    class="oval-svg"
    viewBox="0 0 300 80"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M 18,42 C 8,18 60,8 150,8 C 240,8 296,22 290,46 C 285,68 230,76 150,74 C 70,72 22,64 16,46 C 14,38 22,32 38,30"
      fill="none"
      stroke="var(--color-accent)"
      stroke-width="4"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</span>

<style>
  .oval-wrap {
    position: relative;
    display: inline-block;
    padding-inline: 0.05em;
  }

  .oval-word {
    position: relative;
    z-index: 1;
  }

  .oval-svg {
    position: absolute;
    /* SVG is a replaced element: inset alone won't stretch it, so size it
       explicitly. The flat ellipse converges at its extremes, so the
       horizontal overshoot must scale with word length (percent-based) for
       the curve to clear the first/last letters instead of cutting through. */
    top: -0.52em;
    left: calc(-15% - 0.2em);
    width: calc(130% + 0.4em);
    max-width: none; /* the base.css media reset would clamp the overshoot */
    height: calc(100% + 1.15em);
    z-index: 0;
    overflow: visible;
  }
</style>
