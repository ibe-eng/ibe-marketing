---
interface Props {
  word: string;
}
const { word } = Astro.props;
---

<span class="oval-wrap">
  <span class="oval-word">{word}</span>
  <svg
    class="oval-svg"
    viewBox="0 0 300 80"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M 18,42 C 8,18 60,8 150,8 C 240,8 296,22 290,46 C 285,68 230,76 150,74 C 70,72 22,64 16,46 C 14,38 22,32 38,30"
      fill="none"
      stroke="var(--color-accent)"
      stroke-width="4"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</span>

<style>
  .oval-wrap {
    position: relative;
    display: inline-block;
    padding-inline: 0.05em;
  }

  .oval-word {
    position: relative;
    z-index: 1;
  }

  .oval-svg {
    position: absolute;
    inset: -0.18em -0.1em -0.22em -0.1em;
    width: calc(100% + 0.2em);
    height: calc(100% + 0.4em);
    z-index: 0;
    overflow: visible;
  }
</style>
